# chrm engine local config — copy to .env and fill in
# The engine polls <API_URL>/api/engine/bots every 30s and starts one self-bot per active user.

# Where the engine gets its user list from.
#   - local mock (see mock_api.py):  http://127.0.0.1:8080
#   - real render api:               https://chrm-api.onrender.com
API_URL=http://127.0.0.1:8080

# Must match the API's ENGINE_SECRET (the API falls back to "fallback_secret_123" if unset).
ENGINE_SECRET=fallback_secret_123

# Fernet key used by security.py. Generate once with:
#   .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Port for the engine's own health-check web server.
PORT=8090

# ---- local mock only (mock_api.py reads these) ----
# Your Discord self-bot user token. NEVER commit this.
MOCK_USER_TOKEN=
# The discord_id the engine should treat as this user.
MOCK_DISCORD_ID=000000000000000000
